**************************************************************************************************************
**************************************************************************************************************
	EXIT TRIALS
**************************************************************************************************************
**************************************************************************************************************
<trial b_exit>
/ trialduration = 0
/ ontrialend = [
	values.bMS = expressions.bMS2;
	if (trial.b_trial3.count)
		values.bMS = expressions.bMS3;
	if (trial.b_trial4.count)
		values.bMS = expressions.bMS4;
	if (trial.b_trial5.count)
		values.bMS = expressions.bMS5;
	if (trial.b_trial6.count)
		values.bMS = expressions.bMS6;
	if (trial.b_trial7.count)
		values.bMS = expressions.bMS7;
	if (trial.b_trial8.count)
		values.bMS = expressions.bMS8;
	if (trial.b_trial9.count)
		values.bMS = expressions.bMS9;
	if (trial.b_trial10.count)
		values.bMS = expressions.bMS10;
	if (trial.b_trial11.count)
		values.bMS = expressions.bMS11;
	if (trial.b_trial12.count)
		values.bMS = expressions.bMS12;
	if (trial.b_trial13.count)
		values.bMS = expressions.bMS13;
	if (trial.b_trial14.count)
		values.bMS = expressions.bMS14;
	if (trial.b_trial15.count)
		values.bMS = expressions.bMS15;
	values.MS = values.bMS
]
</trial>

**************************************************************************************************************
**************************************************************************************************************
	PRACTICE TRIALS
**************************************************************************************************************
**************************************************************************************************************
* 	practice trials present at least two level 2 for Backward assessment
* 	practice trials give feedback to participant

<trial b_positivefeedback>
/ stimulusframes = [1 = clearscreen, posfeedback]
/ timeout = 3000
/ recorddata = false
/ branch = [
	if (values.b_countPracticeTrials < parameters.minPracticeTrials){
		return trial.b_practice_digits;
	};
]
</trial>

<trial b_negativefeedback>
/ stimulusframes = [1 = clearscreen, negfeedback, b_negfeedback, continue]
/ validresponse = (continue)
/ recorddata = false
/ branch = [
	if (values.b_countPracticeTrials < parameters.maxPracticeTrials){
		return trial.b_practice_digits;
	} else if (!monkey.monkeymode){
		return trial.prematureEnd;
	};
]
</trial>

<trial prematureEnd>
/ stimulusframes = [1 = prematureEnd, exit]
/ validresponse = (exit)
/ recorddata = false
/ ontrialend = [
	script.abort(false);
]
</trial>

***************************************
Backward Practice
***************************************

<trial b_practice_digits>  
/ ontrialbegin = [
	values.N = 2;
	values.assesstype = 1;
	values.proposedSolution = "";
	values.countTrials += 1;
	values.ACC = 0;
	values.b_countPracticeTrials += 1;	
]
/ stimulustimes = [0 = clearscreen, signal; 1000 = clearscreen, audio_digit1, digit1;  2000 = clearscreen, audio_digit2, digit2; 
						3000 = clearscreen, signal; 4000 = clearscreen]
/ timeout = 4000
/ ontrialend = [
	values.sequence = expressions.f_digitsequence2;
	values.correctSolution = expressions.b_digitsequence2;
]
/ branch = [
	return trial.b_practice_responseInput;
]
/ recorddata = false
</trial>

<trial b_practice_responseInput>  
/ stimulustimes = [0 = b_instructions, response, 1, 2, 3, 4, 5, 6, 7, 8, 9, 00, submit, correctSolution]
/ validresponse = (1, 2, 3, 4, 5, 6, 7, 8, 9, 00, submit)
/ ontrialend = [
	if (trial.b_practice_responseInput.response != "submit" && trial.b_practice_responseInput.response != "erase") {
		if (trial.b_practice_responseInput.response == "00") {
			values.lastDigit = 0;
		} else {
			values.lastDigit = trial.b_practice_responseInput.response;
		};
		values.proposedSolution = concat(values.proposedSolution, values.lastDigit);
	};
]
/ branch = [
	if (trial.b_practice_responseInput.response == "erase") {
		return trial.b_practice_eraseLast;
	} else if (trial.b_practice_responseInput.response == "submit") {
		return trial.b_practice;
	} else {
		return trial.b_practice_responseInput;
	};
]
/ responsemessage = (1, text.1_HL, 50)
/ responsemessage = (2, text.2_HL, 50)
/ responsemessage = (3, text.3_HL, 50)
/ responsemessage = (4, text.4_HL, 50)
/ responsemessage = (5, text.5_HL, 50)
/ responsemessage = (6, text.6_HL, 50)
/ responsemessage = (7, text.7_HL, 50)
/ responsemessage = (8, text.8_HL, 50)
/ responsemessage = (9, text.9_HL, 50)
/ responsemessage = (00, text.00_HL, 50)
/ recorddata = false
</trial>

Note; trial.eraseLast
* erases the last entered digit from the proposed solution (as long as there are digits)
<trial b_practice_eraseLast>
/ ontrialbegin = [
	values.proposedSolution = trimright(values.proposedSolution, values.lastDigit);
	values.lastDigit = substring(values.proposedSolution, length(values.proposedSolution) - 1, 1);
]
/ trialduration = 0
/ branch = [
	return trial.b_practice_responseInput;
]
/ recorddata = false
</trial>

<trial b_practice>
/ trialduration = 0
/ ontrialbegin = [
	if (monkey.monkeymode == true && replace(0,1) == 1) {
		values.proposedSolution = values.correctSolution;
	};
]
/ ontrialend = [
	values.ACC = trial.b_practice.correct;
]
/ iscorrectresponse = [
	return (values.proposedSolution == expressions.b_digitsequence2);
]
/ branch = [
	if (trial.b_practice.correct)
		return trial.b_positivefeedback;
	else
		return trial.b_negativefeedback;
]
/ recorddata = true
</trial>

<trial instructions>
/ stimulusframes = [1=continue, b_practiceinstructions]
/ validresponse = (continue)
</trial>

<trial instructions2>
/ stimulusframes = [1=continue, pre_bblock]
/ validresponse = (continue)
</trial>

<trial post_bblock>
/ stimulusframes = [1=continue, post_bblock]
/ validresponse = (continue)
</trial>

**************************************************************************************************************
**************************************************************************************************************
	BLOCKS
**************************************************************************************************************
**************************************************************************************************************
* Participants are given at least two practice trials to familiarize them with the procedure
* For the actual assessment, each participant is started out on a level 2 sequence
* subsequent trials are chosen based on individual performance of each participant
* max trialnumber = 14


<block b_practiceblock>
/ skip = [
	parameters.maxPracticeTrials < 1 || parameters.minPracticeTrials < 1;
]
/ onblockbegin = [
	values.countTrials = 0;
]
/ trials = [1 = instructions, b_practice_digits]
</block>

<block backward_block>
/ onblockbegin = [
	values.countTrials = 0;
]
/ trials = [1 = instructions2, b_trial2_digits, post_bblock]
</block>


**************************************************************************************************************
**************************************************************************************************************
	EXPERIMENT
**************************************************************************************************************
**************************************************************************************************************

<expt digitspan>
/ blocks = [
	1 = b_practiceblock; 
	2 = backward_block;	

]
</expt>

***************************
debug element
***************************
<text correctSolution>
/ onprepare = [text.correctSolution.skip = !parameters.debugmode;]
/items = ("correct Solution (debugmode): <%values.correctSolution%>")
/fontstyle = ("Arial", 1.5%, false, false, false, false, 5, 1)
/position = (50%, 98%)
/ size = (80%, 2%)
/ txcolor = red
</text>

**************************************************************************************************************
	End of File
**************************************************************************************************************																			

