<block questionairre>
/ trials = [
	1=questionairre1,questionairre2
]
</block>

<trial questionairre1>
/ stimulusframes = [1=whatdidyouthink,Boring,One,Two,Three,Four,Five,Six,Seven,Interesting]
/ validresponse = (One,Two,Three,Four,Five,Six,Seven)
</trial>


<trial questionairre2>
/ stimulusframes = [1=whatdidyouthink,Dull,One,Two,Three,Four,Five,Six,Seven,Exciting]
/ validresponse = (One,Two,Three,Four,Five,Six,Seven)
</trial>


<trial listlists>
/ ontrialbegin = [
	values.timeslistitem = list.times.item(values.yindex);
	values.choiceslistitem = list.choices.item(values.yindex);
]
/ trialduration = 0
/ recorddata = true
/ ontrialend = [
	values.yindex = values.yindex + 1;
]
/ branch = [
	if (values.yindex < 30) {
		return trial.listlists;
	} else {
		return trial.endscreen;
	}
]

</trial>

<block endscreen>
/ onblockbegin = [
	values.yindex = 1;
]

/ trials = [
	1=listlists
]
</block>


<trial endscreen>
/ ontrialbegin = [
	values.randnum = round(rand(1,30));
	values.paydate = list.times.item(values.randnum);
	values.payment = list.choices.item(values.randnum);
]

/ stimulusframes = [
	1=payment
]
/ timeout = 3000


</trial>



<expt main1>
/ blocks = [
	1=instructions;
	2=questions;
	3=questionairre; 
	4=endscreen;
]
</expt>



