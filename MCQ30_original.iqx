<trial Q1>
/ ontrialbegin = [
	values.SS = 54;
	values.LL = 55;
	values.days = 117;	
]
/ stimulusframes = [1=wouldyouprefer,LL,or,SS]
/ validresponse = (LL,SS)
/ ontrialend = [
	if (trial.Q1.response=="SS"){
		values.currenttotal=values.currenttotal+values.SS;
		list.choices.appenditem(values.SS);
		list.times.appenditem(values.zero);
	} elseif (trial.Q1.response=="LL") {
		values.currenttotal=values.currenttotal+values.LL;
		list.choices.appenditem(values.LL);
		list.times.appenditem(values.days);
	}
]
</trial>
