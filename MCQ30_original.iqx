2021-02-23 AndyP
MCQ-30 Discounting Test



<defaults>
/ canvasaspectratio = (4,3)
/ minimumversion = "6.0.0.0"
/ inputdevice = mouse
/ fontstyle = ("Arial", 3%, false, false, false, false, 5, 0)
/ txbgcolor = white
/ txcolor = (0, 0, 0)
</defaults>


<values>
/ currenttotal = 0;
/ SS = 0;
/ LL = 0;
/ days = 0;
/ trial = 0;
/ payment = 0;
/ paydate = 0;
/ randnum = 0;
/ zero = 0;
/ yindex = null;
/ timeslistitem = null;
/ choiceslistitem = null;
</values>

<parameters>
</parameters>


<data>
/ columns = (build, computer.platform, computer.touch, date, time, subject, group, script.sessionid, blockcode, blocknum, 
trialcode,values.trial,values.SS,values.LL,values.days,response,latency,values.currenttotal,values.paydate,values.payment,values.choiceslistitem,values.timeslistitem)
</data>

<list choices>
</list>

<list times>
</list>

<text next>
/ items = ("Next")
/ fontstyle = ("Arial", 3%, false, false, false, false, 5, 0)
/ position = (50%, 75%)
/ size = (25%, 15%)
/ vjustify = center
/ txbgcolor = gainsboro
/ txcolor = black
</text>

<text instructions1>
/ items = ("For each of the next 30 choices, please indicate which reward you would prefer: 
the smaller reward today, or the larger reward in the specified number of days.")
/ fontstyle = ("Arial", 3%, false, false, false, false, 5, 238)
/ position = (50%, 50%)
</text>

<text instructions2>
/ items = ("Please take the choices seriously: they are for REAL MONEY.  

At the end of the session, one of the 30 questions will be selected 
at random and you will get the reward that you chose on that question.  

If you choose the smaller reward, you will get paid before you leave today. 

If you choose the delayed reward, you will get paid in the specified number 
of days and not before.")
/ fontstyle = ("Arial", 3%, false, false, false, false, 5, 238)
/ position = (50%, 45%)
/ vjustify = center
/ hjustify = left
</text>

<text instructions3>
/ items = ("So to make sure that you get a reward you prefer, 
you should answer every question as though it were the one you will win.")
/ fontstyle = ("Arial", 3%, false, false, false, false, 5, 238)
/ position = (50%, 50%)
/ vjustify = center
/ hjustify = left
</text>


<text instructions4>
/ items = ("Please click on ONE of each TWO choices for the following 30 questions:")
/ fontstyle = ("Arial", 3%, false, false, false, false, 5, 238)
/ vjustify = center
/ hjustify = left
/ position = (50%, 60%)
</text>

<text SS>
/ items = ("...$<% values.SS %> today")
/ fontstyle = ("Arial", 3%, false, false, false, false, 5, 0)
/ position = (25%, 50%)
/ size = (25%, 15%)
/ vjustify = center
/ txbgcolor = beige
/ txcolor = black
</text>

<text or>
/ items = ("or")
/ fontstyle = ("Arial", 3%, false, false, false, false, 5, 0)
/ position = (50%, 50%)
/ size = (25%, 15%)
/ vjustify = center
/ txcolor = black
</text>


<text LL>
